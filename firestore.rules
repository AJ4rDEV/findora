rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Disallow querying all users
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 100
        && incoming().preferredLanguage in ['en', 'ar', 'ku', 'tr'];
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'displayName', 'photoURL', 'preferredLanguage', 'themePreference', 'updatedAt']);
      allow delete: if isOwner(userId);

      // User bookmarks subcollection
      match /bookmarks/{reportId} {
        allow read, write: if isOwner(userId);
      }

      // User notifications subcollection
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn(); // System or actors generating notification
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId);
      }
    }

    // 2. Reports collection
    match /reports/{reportId} {
      function isValidReport(data) {
        return data.keys().hasAll(['reportId', 'authorUid', 'type', 'title', 'description', 'category', 'generalLocation', 'eventDate', 'status'])
          && data.reportId is string && data.reportId.size() <= 128
          && data.authorUid == request.auth.uid
          && data.type in ['lost', 'found']
          && data.title is string && data.title.size() >= 3 && data.title.size() <= 150
          && data.description is string && data.description.size() >= 5 && data.description.size() <= 3000
          && data.category in ['electronics', 'keys', 'wallets_bags', 'documents_id', 'clothing', 'jewelry', 'pets', 'books_education', 'vehicles_accessories', 'other']
          && data.generalLocation is string && data.generalLocation.size() >= 2 && data.generalLocation.size() <= 150
          && data.status in ['active', 'resolved', 'closed'];
      }

      allow read: if true; // Public feed of lost and found items
      allow create: if isSignedIn()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().authorUid == request.auth.uid;
      
      allow update: if isSignedIn()
        && existing().authorUid == request.auth.uid
        && incoming().authorUid == existing().authorUid
        && incoming().reportId == existing().reportId
        && (
          // Action 1: Owner editing details or status
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'generalLocation', 'eventDate', 'status', 'images', 'contactPreference', 'updatedAt']) ||
          // Action 2: Incremental counters (comments, likes)
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'updatedAt'])
        );

      allow delete: if isSignedIn() && existing().authorUid == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && isValidId(commentId)
          && incoming().authorUid == request.auth.uid
          && incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 1000;
        allow update: if isSignedIn() && existing().authorUid == request.auth.uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']);
        allow delete: if isSignedIn() && (existing().authorUid == request.auth.uid || get(/databases/$(database)/documents/reports/$(reportId)).data.authorUid == request.auth.uid);
      }

      // Likes subcollection
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
    }

    // 3. Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (resource.data.participants[0] == request.auth.uid || resource.data.participants[1] == request.auth.uid);
      allow create: if isSignedIn() && (incoming().participants[0] == request.auth.uid || incoming().participants[1] == request.auth.uid);
      allow update: if isSignedIn() && (existing().participants[0] == request.auth.uid || existing().participants[1] == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] == request.auth.uid);
        allow create: if isSignedIn()
          && incoming().senderUid == request.auth.uid
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0] == request.auth.uid || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1] == request.auth.uid);
      }
    }
  }
}
